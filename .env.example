APP_ENV=local
APP_NAME="Email Outreach Platform"
DATABASE_URL="postgresql+psycopg://<login-role>:<password>@<supabase-host>:5432/postgres"
REDIS_URL="redis://redis:6379/0"
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
LOG_LEVEL=INFO
LOG_FORMAT=json

# Supabase Auth (JWT verification). SUPABASE_URL is required. Provide EITHER
# the project's legacy JWT secret (HS256) OR nothing if the project uses the
# newer JWKS-based signing keys, which are fetched automatically from
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_JWT_SECRET=""
SUPABASE_JWT_AUDIENCE="authenticated"

# Test/integration-only. Used solely by backend integration tests to create
# and delete throwaway auth users via the Supabase Admin API. Never sent to
# the frontend, never logged, never used outside the test suite.
SUPABASE_SERVICE_ROLE_KEY=""

NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
