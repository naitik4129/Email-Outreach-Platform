APP_ENV=local
APP_NAME="Email Outreach Platform"
DATABASE_URL="postgresql+psycopg://<login-role>:<password>@<supabase-host>:5432/postgres"
REDIS_URL="redis://redis:6379/0"
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
LOG_LEVEL=INFO
LOG_FORMAT=json

# Supabase Auth (JWT verification). SUPABASE_URL is required. Provide EITHER
# the project's legacy JWT secret (HS256) OR nothing if the project uses the
# newer JWKS-based signing keys, which are fetched automatically from
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_JWT_SECRET=""
SUPABASE_JWT_AUDIENCE="authenticated"

# Used by backend integration tests to create/delete throwaway auth users via
# the Supabase Admin API, AND (as of Phase 3) by the backend/worker processes
# to read/write CSV import files in Supabase Storage via its REST API. Never
# sent to the frontend, never logged.
SUPABASE_SERVICE_ROLE_KEY=""

# Phase 3: private Supabase Storage bucket that holds uploaded CSV import
# files. Must already exist in the Supabase project (bucket creation is a
# one-time infra step, not something the app provisions at request time).
SUPABASE_STORAGE_BUCKET="imports"

NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Phase 5: Google OAuth credentials and mailbox credential encryption key.
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are from Google Cloud Console.
# GOOGLE_REDIRECT_URI must match the authorized redirect URI in Google Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/mailboxes/connect/gmail/callback"

# Phase 6: Microsoft (Azure AD) OAuth credentials for the Microsoft Graph
# mailbox provider. MICROSOFT_CLIENT_ID/MICROSOFT_CLIENT_SECRET are from an
# Azure AD app registration. MICROSOFT_REDIRECT_URI must match the
# registered redirect URI. MICROSOFT_TENANT="common" allows both work/school
# and personal Microsoft accounts to connect; narrow to "organizations" or a
# specific tenant GUID only if intentionally restricting account types.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:8000/api/v1/mailboxes/connect/microsoft/callback"
MICROSOFT_TENANT="common"

# AES-256 key for mailbox credential encryption (32 hex bytes or 32 raw characters).
MAILBOX_ENCRYPTION_KEY=""
MAILBOX_ENCRYPTION_KEY_ID="v1"
FRONTEND_BASE_URL="http://localhost:3000"

# Phase 9: Scheduler and outbox configuration
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=5.0
SCHEDULER_BATCH_SIZE=50
SCHEDULER_CLAIM_LEASE_SECONDS=300
OUTBOX_PUBLISH_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=10

# Follow-up progression (see docs/adr/0009). Off by default.
SEQUENCE_PROGRESSION_ENABLED=false
SEQUENCE_PROGRESSION_INTERVAL_SECONDS=30
SEQUENCE_PROGRESSION_CAMPAIGNS_PER_RUN=200
SEQUENCE_PROGRESSION_BATCH_SIZE=100
# Private bucket for step attachments / inline images (see docs/adr/0010).
SUPABASE_ATTACHMENTS_BUCKET="email-attachments"


# Hyper-personalized campaigns (see docs/adr/0011-0013). Off by default.
# Enabling this asserts lead data (never email/phone/LinkedIn) may go to the model
# provider. PERSONALIZATION_MODEL is required when enabled (also by the API, which
# binds sample approvals to it). The API key belongs ONLY in a separate
# .env.personalization file loaded by the worker-personalization service (see
# docker-compose.yml); never put it in .env and never set it for the API process.
PERSONALIZATION_ENABLED=false
PERSONALIZATION_MODEL=
PERSONALIZATION_OPENAI_API_KEY=
PERSONALIZATION_OPENAI_BASE_URL=https://api.openai.com/v1
PERSONALIZATION_REQUEST_TIMEOUT_SECONDS=60
PERSONALIZATION_MAX_OUTPUT_TOKENS=1200
PERSONALIZATION_LEAD_TIME_SECONDS=3600
PERSONALIZATION_MAX_ATTEMPTS=3
PERSONALIZATION_MAX_TRANSIENT_ERRORS=8
PERSONALIZATION_LEASE_SECONDS=300
PERSONALIZATION_DISPATCH_INTERVAL_SECONDS=10
PERSONALIZATION_CAMPAIGNS_PER_RUN=100
PERSONALIZATION_CHUNK_SIZE=10
PERSONALIZATION_MIN_FACTS=2
PERSONALIZATION_WEBSITE_RESEARCH_ENABLED=true
PERSONALIZATION_RPM=60
PERSONALIZATION_DAILY_GENERATION_CAP=2000
PERSONALIZATION_DAILY_PREVIEW_CAP=100
PERSONALIZATION_DAILY_FETCH_CAP=2000
PERSONALIZATION_PREVIEW_TTL_HOURS=168
